#!/bin/bash

recurse() {
 for i in "$1"/*;do
    if [ -d "$i" ];then
        # echo "dir: $i"
        recurse "$i"
    elif [ -f "$i" ]; then
        filename=$(basename "$i")
        if [[ $filename == *.m4a ]]; then
            target="$HOME/Music/${filename:4}"
            cp "$i" "$target"
            echo "Copied: $target"
        fi
    fi
 done
}

recurse .